# Maintainer: JCsvg
#
# Pacote local, construído a partir de um tarball gerado por `git archive`
# (ver packaging/empacotar.sh). Dependências nos repositórios oficiais do Arch
# (extra/python-textual, extra/python-docker, extra/tmux); nada do AUR, nada vendorizado.

pkgname=oma-docker
pkgver=0.1.2
pkgrel=1
pkgdesc="Gerenciador de Docker em TUI, uma tela por vez, para mouse e teclado"
arch=('any')
url="https://github.com/JCsvg/oma-docker"
license=('MIT')
depends=(
  'python>=3.13'
  'python-textual>=8'
  'python-docker'
  'tmux'   # terminal persistente (servidor dedicado do app)
)
optdepends=(
  'docker: o motor que o app gerencia'
  'docker-compose: projetos compose (o app chama `docker compose`)'
  'neovim: editar compose, Dockerfile e .env pelo app'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
checkdepends=('python-pytest' 'python-pytest-asyncio')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')  # tarball local; o empacotar.sh imprime o hash real

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # Só os unitários: os de interface abrem a TUI sem tela e demoram.
  PYTHONPATH=src python -m pytest -q tests/unit -p no:warnings -p no:cacheprovider
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 DECISOES.md "$pkgdir/usr/share/doc/$pkgname/DECISOES.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
